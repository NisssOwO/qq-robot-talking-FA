    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@snowluma/mcp": "^1.14.20",
    "@snowluma/sdk": "^1.14.20",
    "js-yaml": "^4.3.2",
    "zod": "^4.4.3"
